{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Backend Server",
            "type": "debugpy",
            "request": "launch",
            "module": "fastapi",
            "args": [
                "dev"
            ],
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Debug Vision Worker",
            "type": "debugpy",
            "request": "launch",
            "module": "backend.app.vision.worker",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug Benchmark",
            "type": "debugpy",
            "request": "launch",
            "module": "backend.tests.benchmark_yolo",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "cwd": "${workspaceFolder}"
        }
    ]
}